PORT=4000
REDIS_URL=redis://localhost:6379

SALE_ID=flash-sale-1
SALE_NAME=Flash Sale
SALE_STOCK=100

# The sale window must include the current time for purchases to succeed.
# If these are unset, the window is "1 minute ago" to "24 hours from backend start".
SALE_STARTS_AT=2026-01-01T00:00:00.000Z
SALE_ENDS_AT=2030-01-01T00:00:00.000Z
